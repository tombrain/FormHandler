{
    "name": "tomdabrain/formhandler",
    "type": "library",
    "description": "Interactive forms within 10 lines",
    "homepage": "http://www.formhandler.net/",
    "license": "LGPL-2.1-only",
    "support": {
        "forum": "http://www.formhandler.net/forum_index.html",
